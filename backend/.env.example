# ---------------------------------------------------------------
# FactAlign backend configuration.  Copy this file to ".env".
# Never commit ".env".  Secrets stay on the server; the browser
# never receives them.
# ---------------------------------------------------------------

# Groq API key. Leave EMPTY to run in demo mode (no LLM calls).
GROQ_API_KEY=

# Default Groq model used for summarization and LLM verification.
# Can be changed later in the Settings page (stored in the database).
GROQ_MODEL=llama-3.3-70b-versatile

# auto  = real LLM if GROQ_API_KEY is set, otherwise demo mode
# demo  = always use the rule-based extractive demo engine
# real  = always call the LLM; errors if the key is missing
PROVIDER_MODE=auto

# Database URL. SQLite by default (file is created automatically).
# PostgreSQL also works, e.g. postgresql+psycopg://user:pass@localhost:5432/FactAlign
# (pip install "psycopg[binary]" first).
# DATABASE_URL=sqlite:///./data/FactAlign.db

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Timeout (seconds) for each LLM request.
LLM_TIMEOUT_SECONDS=90

# Input limits.
MAX_INPUT_CHARS=60000
MAX_UPLOAD_MB=5

# Documents longer than this many characters are summarized in chunks and merged.
CHUNK_CHARS=6000

# Optional claim-level verification (install requirements-nli.txt first).
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
NLI_MODEL=joeddav/xlm-roberta-large-xnli
# Cache models explicitly with: python scripts/cache_verification_models.py
# True prevents automatic downloads when a verification request arrives.
VERIFICATION_LOCAL_ONLY=true
NLI_DECISION_THRESHOLD=0.75
NLI_DECISION_MARGIN=0.15
