# Next.js proxies browser /api requests to the backend. No browser CORS setup needed.
BACKEND_API_URL=http://127.0.0.1:8000
# Optional: use a public backend URL directly instead (requires backend CORS_ORIGINS).
# NEXT_PUBLIC_API_URL=https://api.example.com
# Never put API keys in frontend env files. Set GROQ_API_KEY in backend/.env.
